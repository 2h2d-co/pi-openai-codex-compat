amends "package://github.com/2h2d-co/hk-config/releases/download/v0.13.1/hk-config@0.13.1#/Config.pkl"

import "package://github.com/2h2d-co/hk-config/releases/download/v0.13.1/hk-config@0.13.1#/Base.pkl" as Base
import "package://github.com/2h2d-co/hk-config/releases/download/v0.13.1/hk-config@0.13.1#/GitHubActions.pkl" as GitHubActions
import "package://github.com/2h2d-co/hk-config/releases/download/v0.13.1/hk-config@0.13.1#/TypeScript.pkl" as TypeScript

local projectSteps = (Base.baseSteps) {
  ...TypeScript.typeScriptSteps
  ...GitHubActions.gitHubActionsSteps
}

display_skip_reasons = Base.displaySkipReasons
hooks = Base.defaultHooks(true, projectSteps)
